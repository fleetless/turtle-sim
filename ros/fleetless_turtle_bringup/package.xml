<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<!-- SPDX-License-Identifier: Apache-2.0 -->
<package format="3">
  <name>fleetless_turtle_bringup</name>
  <!-- The image carries the version (org.opencontainers.image.version).
       These packages are not released on their own. -->
  <version>0.0.0</version>
  <description>The one launch file: simulator, cameras, view and, with a token, the Fleetless Bridge.</description>
  <maintainer email="hello@fleetless.dev">Dehne Robotik GmbH</maintainer>
  <license>Apache-2.0</license>
  <url type="repository">https://github.com/fleetless/turtle-sim</url>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ros2launch</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>fleetless_turtle_sim</exec_depend>
  <exec_depend>fleetless_turtle_cameras</exec_depend>
  <exec_depend>fleetless_turtle_viewer</exec_depend>
  <!-- Included when FLEETLESS_TOKEN is set. It comes from Fleetless's apt
       repository, not from rosdep; the Dockerfile installs it. -->
  <exec_depend>fleetless_bridge</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
