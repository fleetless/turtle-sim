<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<!-- SPDX-License-Identifier: Apache-2.0 -->
<package format="3">
  <name>fleetless_turtle_description</name>
  <!-- The image carries the version (org.opencontainers.image.version).
       These packages are not released on their own. -->
  <version>0.0.0</version>
  <description>The turtle's model: a plain URDF and the meshes it names.</description>
  <maintainer email="hello@fleetless.dev">Dehne Robotik GmbH</maintainer>
  <license>Apache-2.0</license>
  <url type="repository">https://github.com/fleetless/turtle-sim</url>

  <test_depend>python3-pytest</test_depend>
  <test_depend>ament_index_python</test_depend>
  <!-- check_urdf -->
  <test_depend>liburdfdom-tools</test_depend>
  <!-- The joints' names and how far they swing: the simulator's core says. -->
  <test_depend>fleetless_turtle_sim</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
