# Drives the turtle onto the charging pad and waits there until the battery
# has reached the target.
float32 target_percent      # 1..100
---
bool success
string reason
string message
float32 battery_percent
float32 duration_s
---
# Feedback, 2 Hz.
string phase                # driving | charging
float32 battery_percent
float32 remaining_m
