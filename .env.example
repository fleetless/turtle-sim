# SPDX-License-Identifier: Apache-2.0
# The turtle's variables, for `docker compose up`. Copy this file to `.env`
# and write the robot's token into it. `.env` is never committed.

# The robot's token, from the console. Empty: no bridge is started.
FLEETLESS_TOKEN=

# The cloud the bridge connects to. Unset: the bridge's own default.
# FLEETLESS_CLOUD_URL=

# The map file, as the container sees it.
# TURTLE_MAP=/opt/turtle/maps/garden.png

# Factor on the battery's discharge. 0 turns it off.
# TURTLE_BATTERY_DRAIN=1.0

# The port the view listens on, in the container and on this machine.
# TURTLE_VIEW_PORT=8765
